+WWINLINE int WWMath::Float_To_Int_Floor(const float& f)
+{
+ // Preserve original x86 modulo-32 shift counts and two-complement arithmetic.
+ static_assert(sizeof(int) == 4 && sizeof(float) == 4, "WWMath requires 32-bit int and float");
+ uint32_t bits; memcpy(&bits, &f, sizeof(bits));
+ const uint32_t sign = 0u - (bits >> 31);
+ const uint32_t absolute = bits & 0x7fffffffu;
+ const int exponent = int(absolute >> 23) - 127;
+ const uint32_t exponent_mask = exponent < 0 ? 0u : UINT32_MAX;
+ const unsigned shift = unsigned(31 - exponent) & 31u;
+ const uint32_t integer_mask = (uint32_t(1) << shift) - 1u;
+ const uint32_t mantissa = absolute & 0x7fffffu;
+ const uint32_t magnitude = ((mantissa | 0x800000u) << 8) >> shift;
+ const uint32_t correction = uint32_t(!((mantissa << 8) & integer_mask)) &
+     (exponent_mask ^ (absolute == 0 ? UINT32_MAX : 0u)) & sign;
+ const uint32_t result = ((magnitude & exponent_mask) ^ sign) + correction;
+ int output; memcpy(&output, &result, sizeof(output)); return output;
 }
 
