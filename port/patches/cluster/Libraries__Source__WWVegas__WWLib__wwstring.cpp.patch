+StringClass::Format_Args (const TCHAR *format, va_list & arg_list )
+{
+ if (!format) return -1;
+ va_list count_args;va_copy(count_args,arg_list);
+ const int required=vsnprintf(NULL,0,format,count_args);va_end(count_args);
+ if (required<0 || required==INT_MAX) return -1;
+ std::vector<char> buffer(size_t(required)+1);
+ va_list output_args;va_copy(output_args,arg_list);
+ const int written=vsnprintf(buffer.data(),buffer.size(),format,output_args);va_end(output_args);
+ if (written!=required) return -1;
+ (*this)=buffer.data();
+ return written;
 }
 
 
