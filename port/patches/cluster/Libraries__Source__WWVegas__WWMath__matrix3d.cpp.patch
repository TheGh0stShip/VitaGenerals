+namespace {
+// Six triple products produce at most twelve binary64 expansion terms.
+// Binary32 factors bound magnitude below 2^384 and smallest quantum at 2^-447;
+// six terms and their exact sums stay within normal binary64 range.
+double affine_determinant(const Matrix3D &matrix)
+{
+ const int indices[6][3]={{0,1,2},{1,2,0},{2,0,1},{2,1,0},{1,0,2},{0,2,1}};
+ double expansion[16]={}; int length=0;
+ for (int term=0;term<6;++term) {
+  const double product=double(matrix[0][indices[term][0]])*matrix[1][indices[term][1]];
+  const double factor=matrix[2][indices[term][2]];
+  const double high=product*factor;
+  // Dekker split avoids dependence on the SDK non-fused fma provider.
+  const double product_split=134217729.0*product;
+  const double product_high=product_split-(product_split-product);
+  const double product_low=product-product_high;
+  const double factor_split=134217729.0*factor;
+  const double factor_high=factor_split-(factor_split-factor);
+  const double factor_low=factor-factor_high;
+  const double low=product_low*factor_low-
+      (((high-product_high*factor_high)-product_low*factor_high)-product_high*factor_low);
+  const double parts[2]={term<3?low:-low,term<3?high:-high};
+  for (int part=0;part<2;++part) {
+   double next[16]={}; int next_length=0; double carry=parts[part];
+   for (int entry=0;entry<length;++entry) {
+    const double value=expansion[entry];
+    const double sum=carry+value;
+    const double value_virtual=sum-carry;
+    const double carry_virtual=sum-value_virtual;
+    const double error=(carry-carry_virtual)+(value-value_virtual);
+    if (error!=0.0) next[next_length++]=error;
+    carry=sum;
+   }
+   if (carry!=0.0) next[next_length++]=carry;
+   length=next_length;
+   for (int entry=0;entry<length;++entry) expansion[entry]=next[entry];
+  }
+ }
+ double determinant=0.0;
+ for (int entry=0;entry<length;++entry) determinant+=expansion[entry];
+ return determinant;
+}
+}
