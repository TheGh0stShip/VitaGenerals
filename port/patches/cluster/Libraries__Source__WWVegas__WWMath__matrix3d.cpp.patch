+bool Matrix3D::Try_Get_Inverse(Matrix3D & inv) const
+{
+ if (fegetround()!=FE_TONEAREST) return false;
+#if defined(GENERALS_PLATFORM_VITA) && defined(__arm__)
+ unsigned status; __asm__ volatile("vmrs %0, fpscr" : "=r"(status));
+ if ((status & 0x01000000u)!=0) return false; // VFP flush-to-zero
+#elif defined(__SSE2__)
+ if ((_mm_getcsr() & 0x8040u)!=0) return false; // Host FTZ/DAZ
+#endif
+ for (int r=0;r<3;++r) for (int c=0;c<4;++c)
+  if (!std::isfinite(Row[r][c])) return false;
+ const double a=Row[0][0], b=Row[0][1], c=Row[0][2];
+ const double d=Row[1][0], e=Row[1][1], f=Row[1][2];
+ const double g=Row[2][0], h=Row[2][1], i=Row[2][2];
+ const double A=e*i-f*h, B=f*g-d*i, C=d*h-e*g;
+ const double determinant=affine_determinant(*this);
+ if (determinant==0.0) return false;
+ const double reciprocal=1.0/determinant;
+ double output[3][4]={
+  {A*reciprocal,(c*h-b*i)*reciprocal,(b*f-c*e)*reciprocal,0},
+  {B*reciprocal,(a*i-c*g)*reciprocal,(c*d-a*f)*reciprocal,0},
+  {C*reciprocal,(b*g-a*h)*reciprocal,(a*e-b*d)*reciprocal,0}};
+ for (int r=0;r<3;++r)
+  output[r][3]=-(output[r][0]*Row[0][3]+output[r][1]*Row[1][3]+output[r][2]*Row[2][3]);
+ Matrix3D result(false);
+ for (int r=0;r<3;++r) for (int c=0;c<4;++c) {
+  const double value=output[r][c];
+  if (!std::isfinite(value) || std::fabs(value)>std::numeric_limits<float>::max()) return false;
+  result[r][c]=static_cast<float>(value);
+ }
+ inv=result;
+ return true;
 }
 
