+static int random_signed_bits(uint32_t bits)
+{
+	static_assert(sizeof(int) == sizeof(uint32_t), "Random state requires 32-bit int");
+	int value;
+	std::memcpy(&value, &bits, sizeof(value));
+	return value;
+}
+
+static uint32_t random_asr16(uint32_t bits)
+{
+	return (bits >> 16) | ((bits & UINT32_C(0x80000000)) ? UINT32_C(0xffff0000) : 0);
+}
 
