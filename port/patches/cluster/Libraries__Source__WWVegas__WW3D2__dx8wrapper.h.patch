+WWINLINE void DX8Wrapper::Clamp_Color(Vector4& color)
+{
+    // Reproduce the original CMOV bit clamp, including signed zero and NaNs,
+    // without aliasing float storage or requiring aligned integer loads.
+    float *components[] = { &color.X, &color.Y, &color.Z, &color.W };
+    for (int i = 0; i < 4; ++i) {
